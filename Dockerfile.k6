# syntax=docker/dockerfile:1.7

FROM grafana/k6:2.1.0

USER root

COPY scripts/load.js /scripts/load.js
RUN mkdir -p /tmp/summary && chmod 0777 /tmp/summary

ENV BASE_URL=http://io-uring-benchmark-server.io-uring-benchmark.svc.cluster.local:8080
ENV SUMMARY_DIR=/tmp/summary


ENTRYPOINT ["k6"]
CMD ["run", "/scripts/load.js"]
